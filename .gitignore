# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.playwright-mcp/
.vercel
.env*.local

.vercel
.env*

# TestSprite CLI run bundles (contain presigned recording URLs)
.testsprite/

# Stryker (mutation testing) sandbox and reports; Schemathesis cache
.stryker-tmp/
reports/mutation/
.schemathesis/
lighthouse-report/
.lighthouseci/
# Demo video: generated narration, recordings and renders (video/README.md rebuilds them)
video/node_modules/
video/out/
video/public/*.webm
video/public/*.mp3

# local copies of the deployed spec and Respect output (CI downloads them)
/openapi.json
/respect-report.json
